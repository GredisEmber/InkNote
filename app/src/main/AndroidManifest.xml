<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      刻意不声明任何权限：
        · 笔记存在 App 私有目录（filesDir），读写不需要任何存储权限
        · 不联网、不登录、不云同步，所以不需要 INTERNET
        · 导出图片走 MediaStore (API 29+)，同样不需要 WRITE_EXTERNAL_STORAGE
      以后如果真的要导出到「下载」目录，也应该是用 MediaStore API 而不是申请权限。
    -->

    <application
        android:name=".InkApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InkNote">

        <!--
          allowBackup="false"：关掉 Android 自动备份。
          这个开关默认是开的，会把笔记上传到用户的 Google Drive ——
          对一个明确要求「不要云同步」的 App，这是必须显式关掉的默认行为。
        -->

        <!--
          configChanges 是给手写画布用的，不是随手加的：
          画布的文档坐标系在第一次布局时锁定，如果旋屏导致 Activity 重建，
          新画布会用新的视图尺寸重新锁定坐标系，已经画好的笔迹就会错位。
          自己处理这几个配置变化，View 实例和它的坐标系就都活着。
          注意没加 uiMode —— 深色模式切换仍然走重建，那是正确且必要的，
          而且此时笔迹已经存进仓库，重建后会重新载入。
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:theme="@style/Theme.InkNote"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
